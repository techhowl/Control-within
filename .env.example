# ============================================================================
# Control Within — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored; this template (.env.example) is committed.
# ============================================================================

# --- Supabase (required for the journey backend) ---------------------------
# Project Settings -> Data API -> Project URL (base URL, NO /rest/v1/ suffix)
SUPABASE_URL=
# Project Settings -> API Keys -> service_role (SECRET — server only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp handoff (required for /api/whatsapp/handoff) ------------------
# Business number in international format, digits only, no + or spaces.
# Example for India: 919999999999
WHATSAPP_NUMBER=

# --- Phase 2: Interakt (WhatsApp) — leave blank until you have an account ---
# Inbound webhooks require an Interakt Advanced/Enterprise plan.
INTERAKT_API_KEY=
INTERAKT_WEBHOOK_SECRET=
# Approved WhatsApp template used by /api/appointment-notify (body placeholders
# {{1}}=appointment_id, {{2}}=name, {{3}}=gender, {{4}}=age,
# {{5}}=contact/mobile, {{6}}="city - pincode" (combined).
INTERAKT_DOCTOR_TEMPLATE=patient_appointment
INTERAKT_TEMPLATE_LANG=en

# --- Phase 2: Zoho CRM — leave blank until field mapping is decided ---------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=
# OAuth token host (default https://accounts.zoho.in for the India DC).
ZOHO_ACCOUNTS_DOMAIN=
# Custom module for anonymous doctor-locator records.
ZOHO_LOCATOR_MODULE=Doctor_Locators
# Standard Leads module for paid/QR attribution leads. Requires custom fields
# Chat_ID, UTM_Source, UTM_Medium, UTM_Campaign, UTM_Content, UTM_Term,
# Placement, Platform, Src; Company must be non-mandatory in the Leads layout.
ZOHO_LEADS_MODULE=Leads

# --- UTM attribution (Valkey session store + /api/attribution/*) ------------
# Valkey/Redis service URI. Use rediss:// for TLS (Aiven, Upstash, …).
VALKEY_URL=
# Shared secret Interakt must send as `x-api-key` on /api/attribution/claim.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ATTRIBUTION_API_KEY=
# Salt for sha256(mobile) — raw phone numbers are never stored in Valkey.
ATTR_MOBILE_SALT=

# Matching windows (seconds). Interakt's Created_at (WhatsApp contact creation)
# is the primary anchor; when it is older than ATTR_STALE_SEC the contact is a
# returning one, so matching falls back to the API arrival time.
ATTR_STALE_SEC=900
ATTR_CREATED_MAX_LAG_SEC=600
ATTR_CREATED_EXPECTED_LAG_SEC=25
ATTR_ARRIVAL_MIN_LAG_SEC=10
ATTR_ARRIVAL_MAX_LAG_SEC=420
ATTR_ARRIVAL_EXPECTED_LAG_SEC=70

# Written to the Lead when no session matches, so every Lead still has a source.
ATTR_DEFAULT_UTM_SOURCE=Whatsapp
ATTR_DEFAULT_UTM_MEDIUM=Whatsapp
ATTR_DEFAULT_PLATFORM=Whatsapp
ATTR_DEFAULT_UTM_CAMPAIGN=Connexi * Howl

# --- /api/nearest-doctor radius fallback -------------------------------------
# Last-resort match distance. Tried only after exact pincode, postal district
# and city name have all missed: a doctor this close to the requester's pincode
# is returned instead of a 404. Coordinates come from src/data/pincodes.json,
# which is built out to 75 km, so anything up to that works without a rebuild.
NEAREST_DOCTOR_RADIUS_KM=30
